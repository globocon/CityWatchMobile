<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>LSRequiresIPhoneOS</key>
		<true />
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>
		<key>UIRequiredDeviceCapabilities</key>
		<array>
			<string>arm64</string>
		</array>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>XSAppIconAssets</key>
		<string>Assets.xcassets/appicon.appiconset</string>
		<!-- Uncomment for testing in http -->
		<!-- <key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
		</dict>  -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>This app uses your location while in use to verify and record on-site security patrol activities, ensuring accuracy and accountability.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>This app requires continuous location access to monitor and validate security patrol movements in real time, ensuring patrol integrity and enhancing safety compliance.</string>
		<!-- iOS branch: patrol tracking runs only while the app is in the foreground. The
		     'location' and 'fetch' modes are not declared because nothing uses them in the
		     background (App Store guideline 2.5.4). Add 'location' back only together with
		     a real iOS background location updater. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
		</array>
		<!-- iOS branch: Bluetooth/iBeacon scanning is Android-only, so no bluetooth
		     background modes or NSBluetooth* usage descriptions are declared here. -->
		<!-- NFC usage description -->
		<key>NFCReaderUsageDescription</key>
		<string>This app uses NFC to scan designated patrol checkpoints during security operations for the purpose of recording and verifying patrol activities, ensuring adherence to assigned patrol schedules, and maintaining audit and compliance records.</string>
		<!-- Camera usage description (in-app camera of the logbook image picker) -->
		<key>NSCameraUsageDescription</key>
		<string>This app uses the camera to take photos that are attached to logbook entries as proof of on-site security patrol activities.</string>
		<!-- Microphone usage description -->
		<!-- <key>NSMicrophoneUsageDescription</key>
		<string>This app requires microphone access for audio and video features.</string> -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>This app requires access to your photo library to select images for the purpose of uploading proof of on-site security patrol activities.</string>
	</dict>
</plist>
