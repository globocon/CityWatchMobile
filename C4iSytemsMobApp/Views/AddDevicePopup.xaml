<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="C4iSytemsMobApp.Views.AddDevicePopup">

    <Frame Padding="20"
           CornerRadius="0"
           HasShadow="False"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           WidthRequest="280"
           BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

        <VerticalStackLayout Spacing="15">

            <Label Text="Select Option"
                   FontSize="20"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

            <Button Text="Add NFC Tag"
                    Clicked="OnAddNfcClicked" />

            <!-- iBeacon work is Android only - see the constructor. -->
            <Button x:Name="ButtonAddIBeacon"
                    Text="Add iBeacon"
                    Clicked="OnAddIBeaconClicked" />

            <!-- Cancel sits between the Add and Edit pairs rather than at the bottom: it is the
                 way out of the menu, not a third thing to do, and putting it in the middle keeps
                 it away from the two destructive-looking Edit options at thumb height.

                 The arrow is FontAwesome's solid arrow-left (f060) rather than the "←"
                 character, which is a hairline in the system font and all but disappeared at
                 this size. ImageSource + ContentLayout keeps the button's normal styling, so
                 only the arrow changes. -->
            <Button Text="Cancel"
                    TextColor="Red"
                    FontAttributes="Bold"
                    ImageSource="{FontImageSource Glyph=&#xf060;, FontFamily=FontAwesome, Size=18, Color=Red}"
                    ContentLayout="Left,10"
                    HorizontalOptions="Fill"
                    Clicked="OnCancelClicked" />

            <Button Text="Edit NFC Tag"
                    Clicked="OnEditNfcClicked" />

            <Button x:Name="ButtonEditIBeacon"
                    Text="Edit iBeacon"
                    Clicked="OnEditIBeaconClicked" />
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>
