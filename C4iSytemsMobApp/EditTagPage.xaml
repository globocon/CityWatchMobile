<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:C4iSytemsMobApp.Services"
             x:Class="C4iSytemsMobApp.EditTagPage"
             Title="Edit Tag">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          Padding="20"
          RowSpacing="10">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center">

            <Button Text="← Back"
                    Clicked="OnCloseClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#512bd4, Dark=#ac99ea}"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    Grid.Column="0" />

            <Label x:Name="LabelTitle"
                   Text="Edit Tag"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Grid.Column="1"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <ImageButton Source="home.png"
                         Clicked="OnHomeClicked"
                         HeightRequest="50"
                         WidthRequest="50"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Grid.Column="2" />
        </Grid>

        <!-- Status line, and which site's logbook the edit will be stamped into -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="3">
            <Label x:Name="LabelInfo"
                   Text=""
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <Label x:Name="LabelSiteName"
                   IsVisible="False"
                   FontSize="12"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#512bd4, Dark=#ac99ea}" />
        </VerticalStackLayout>

        <!-- Bluetooth controls. iBeacon only: an NFC tag announces itself when tapped, a
             beacon has to be hunted for. -->
        <VerticalStackLayout x:Name="BleControls"
                             Grid.Row="2"
                             IsVisible="False"
                             Spacing="8">

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">

                <Button x:Name="ButtonStartScan"
                        Text="Scan for devices"
                        Clicked="OnStartBleScanClicked"
                        Grid.Column="0" />

                <Button x:Name="ButtonStopScan"
                        Text="Stop"
                        Clicked="OnStopBleScanClicked"
                        IsEnabled="False"
                        Grid.Column="1" />
            </Grid>

            <!-- Scanning feedback. A BLE scan finds nothing for seconds at a time, so without
                 this the page looks frozen and the guard presses Scan again. -->
            <HorizontalStackLayout x:Name="ScanningIndicator"
                                   IsVisible="False"
                                   Spacing="8"
                                   HorizontalOptions="Center">

                <ActivityIndicator x:Name="ScanSpinner"
                                   IsRunning="False"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   Color="{AppThemeBinding Light=#512bd4, Dark=#ac99ea}"
                                   VerticalOptions="Center" />

                <Label x:Name="ScanPulseLabel"
                       Text="Scanning"
                       FontSize="13"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#512bd4, Dark=#ac99ea}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Discovered beacons. Tapping one is the equivalent of tapping an NFC tag. -->
        <!-- Items are picked with a TapGestureRecognizer on the card, not CollectionView
             selection: the Frame wrapping each item swallows the touch on Android and
             SelectionChanged never fires. This is the pattern RosterPage already uses. -->
        <CollectionView x:Name="BleDeviceList"
                        Grid.Row="3"
                        IsVisible="False"
                        ItemsSource="{Binding Devices}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No devices found yet. Press Scan for devices."
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:DeviceFound">
                    <Frame HasShadow="False"
                           CornerRadius="8"
                           Padding="12"
                           Margin="0,4"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                           BackgroundColor="{AppThemeBinding Light=#F7F6FD, Dark=#2A2A2A}">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBleDeviceTapped"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding DeviceName}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <Label Text="{Binding MacID}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- The tag, once it has been found in the database -->
        <ScrollView x:Name="TagDetailPanel"
                    Grid.Row="3"
                    IsVisible="False">
            <VerticalStackLayout Spacing="10">

                <Label Text="Site"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />
                <Label x:Name="LabelTagSite"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Label Text="HEX code"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />
                <Label x:Name="LabelTagUid"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Label Text="Current description"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />
                <Label x:Name="LabelCurrentDescription"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Label Text="New description"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />
                <Entry x:Name="txtNewDescription"
                       Placeholder="Enter the new description"
                       MaxLength="100"
                       FontSize="14" />

                <Button x:Name="ButtonSave"
                        Text="Save changes"
                        Clicked="OnSaveClicked" />

                <Button Text="Scan another"
                        Clicked="OnScanAnotherClicked"
                        BackgroundColor="Transparent"
                        BorderWidth="1"
                        BorderColor="{AppThemeBinding Light=#512bd4, Dark=#ac99ea}"
                        TextColor="{AppThemeBinding Light=#512bd4, Dark=#ac99ea}" />
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="LoadingIndicator"
                           Grid.Row="4"
                           IsVisible="False"
                           IsRunning="False"
                           HorizontalOptions="Center" />
    </Grid>
</ContentPage>
