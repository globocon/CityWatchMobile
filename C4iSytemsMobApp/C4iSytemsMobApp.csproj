		<PackageReference Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.16" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.22" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.22">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.101" />
		<!-- Pinned BELOW MauiVersion on purpose: 10.0.101's Resizetizer throws
		     MissingMethodException (SkiaSharp/Svg.Skia pair mismatch) on any SVG that
		     uses text or filter effects. Remove the pin when a fixed MAUI ships. -->
		<PackageReference Include="Microsoft.Maui.Resizetizer" Version="10.0.90" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
		<PackageReference Include="Plugin.BLE" Version="3.2.0" />
		<PackageReference Include="Plugin.Maui.Audio" Version="3.0.1" />
		<PackageReference Include="Plugin.MediaManager" Version="1.2.2" />
		<PackageReference Include="Plugin.NFC" Version="0.1.26" />
		<PackageReference Include="ZXing.Net.Maui" Version="0.10.4" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
	</ItemGroup>

	<!-- FCM remote nudge (tracking §Push). Android only. 125.1.1.1 pairs with the AndroidX
	     generation MAUI 10 itself pulls (the old 123.x pin and its .Ktx shims existed only
	     to coexist with MAUI 8 + Camera 1.0.5 — both gone with the API-36 migration).
	     google-services.json is the per-environment Firebase client config: included only
	     when present so any checkout still builds without it, and it stays OUT of source
	     control (.gitignore). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.1.1" />
		<GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
		<!-- AndroidX .Ktx shims pinned LEVEL with their base packages (same story as the
		     old MAUI-8 pins): androidx merged the ktx classes into the base jars, so a
		     .Ktx package older than its base ships the same classes twice and D8 fails
		     ("androidx/fragment/app/FragmentKt.class"). At matching versions the .Ktx
		     packages are empty pass-throughs. Versions = the bases MAUI 10.0.101 +
		     Firebase 125.1.1.1 resolve; re-level after any bump of either. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
	</ItemGroup>

	<!-- Google Play build: `-p:PlayStoreBuild=true` produces the store variant. Play policy
	     forbids REQUEST_INSTALL_PACKAGES for apps that are not installers, and a store app
	     must update THROUGH the store — so the main manifest omits the permission, the
	     PLAYSTORE constant compiles the sideload self-update flow out (AppUpdateService)
	     and points AppConfig at live. A plain build merges the sideload overlay back in,
	     keeping today's sideload behaviour unchanged. (Additive overlay on purpose: the
	     legacy merger ignores tools:node="remove", so subtracting is not reliable.) -->
	<PropertyGroup Condition="'$(PlayStoreBuild)' == 'true'">
		<DefineConstants>$(DefineConstants);PLAYSTORE</DefineConstants>
	</PropertyGroup>
	<PropertyGroup>
		<!-- Overlay merging needs the real (Gradle-style) manifest merger on both variants,
		     so the two builds differ only by the overlay itself. -->
		<AndroidManifestMerger>manifestmerger.jar</AndroidManifestMerger>
	</PropertyGroup>
	<ItemGroup Condition="'$(PlayStoreBuild)' != 'true' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidManifestOverlay Include="Platforms\Android\SideloadManifestOverlay.xml" />
	</ItemGroup>

