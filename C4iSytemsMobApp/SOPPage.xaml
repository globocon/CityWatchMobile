<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C4iSytemsMobApp.SOPPage"
             Title="SOPPage">
    <VerticalStackLayout Padding="20"
                         Spacing="10">

        <!-- Row with Back (left) and Home (right) -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center"
              Padding="0,5">

            <!-- Back Button -->
            <Button Text="← Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="Blue"
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Grid.Column="0" />

            <!-- Title Label -->
            <Label Text="SOP"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Grid.Column="1"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <!-- Home Button -->
            <ImageButton Source="home.png"
                         Clicked="OnHomeClicked"
                         HeightRequest="50"
                         WidthRequest="50"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Grid.Column="2" />
        </Grid>

        <!-- Which site these SOPs belong to. Only shown on a patrol car or inspection tour,
             where the site changes as the guard scans - on a standard tour it is always the
             site they logged in at and saying so adds nothing. Mirrors the "LogBook: <site>"
             line on the log activity page. -->
        <Label x:Name="SopSiteName"
               IsVisible="False"
               FontSize="13"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,5"
               TextColor="{AppThemeBinding Light=#512bd4, Dark=#ac99ea}" />

        <!-- File List -->
        <CollectionView ItemsSource="{Binding StaffDocuments}"
                        Margin="10"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Add spacing around each card -->
                        <Frame HasShadow="False"
                               BackgroundColor="#f0f0f0"
                               CornerRadius="8"
                               Padding="10"
                               Margin="0,5,0,5">
                            <!-- Top & Bottom spacing -->

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">

                                <!-- File Name -->
                                <Label Text="{Binding FileName}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="DarkSlateGray"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2"
                                       Grid.Column="0"
                                       VerticalOptions="Center"
                                       HorizontalOptions="StartAndExpand" />

                                <!-- Download Button -->
                                <ImageButton Source="download_icon.png"
                                             CommandParameter="{Binding FilePath}"
                                             Clicked="OnDownloadClicked"
                                             BackgroundColor="Transparent"
                                             WidthRequest="30"
                                             HeightRequest="30"
                                             Grid.Column="1"
                                             VerticalOptions="Center"
                                             HorizontalOptions="End" />
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>






    </VerticalStackLayout>
</ContentPage>